# Canonical origin of the site (canonical links, og:url, sitemap). Replace with the real domain.
SITE_URL=http://localhost:4321

# Staging gate: with PUBLIC_NOINDEX=true every page gets `noindex,nofollow`, robots.txt disallows everything
# and no sitemap is generated. Leave it unset (or false) in production.
PUBLIC_NOINDEX=false

# --- CMS (Laravel / Filament backend, ../backend) ---
# The build fetches GET $CMS_API_URL/export with `Authorization: Bearer $CMS_API_TOKEN`.
# Locally: `php artisan serve` in ../backend, token = CMS_EXPORT_TOKEN from ../backend/.env.
CMS_API_URL=http://127.0.0.1:8000/cms-api/v1
CMS_API_TOKEN=

# Data source of the build:
#   api      = live export from the backend (CI / Jenkins; the build fails when it is unreachable)
#   fixture  = committed src/lib/cms/fixture.json, no backend needed (local and PR builds; in CI only when CMS_SOURCE=fixture is set explicitly in the environment)
# Unset = api when CMS_API_TOKEN is set, otherwise fixture.
CMS_SOURCE=

# Dev server only: backend origin that serves /_cms/ media when CMS_SOURCE=api.
DEV_BACKEND_URL=http://127.0.0.1:8000
